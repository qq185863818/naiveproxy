+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/cronet/tls_signature_algorithm_mapper.h"
+
+#include <map>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace cronet {
+
+namespace {
+
+const std::map<std::string, uint16_t>& SignatureAlgorithms() {
+  static const base::NoDestructor<std::map<std::string, uint16_t>> map({
+      {"RSA_PKCS1_SHA256", 0x0401},
+      {"ECDSA_SECP256R1_SHA256", 0x0403},
+      {"ECDSA_SECP384R1_SHA384", 0x0503},
+      {"RSA_PKCS1_SHA384", 0x0501},
+      {"RSA_PKCS1_SHA512", 0x0601},
+      {"RSA_PSS_RSAE_SHA256", 0x0804},
+      {"RSA_PSS_RSAE_SHA384", 0x0805},
+      {"RSA_PSS_RSAE_SHA512", 0x0806},
+      {"ED25519", 0x0807},
+      {"MLDSA44", 0x0904},
+      {"MLDSA65", 0x0905},
+      {"MLDSA87", 0x0906},
+  });
+  return *map;
+}
+
+}  // namespace
+
+uint16_t TLSSignatureAlgorithmMapper::NameToId(const std::string& name) {
+  std::string normalized = base::ToUpperASCII(name);
+  base::TrimWhitespaceASCII(normalized, base::TRIM_ALL, &normalized);
+  if (base::StartsWith(normalized, "UNKNOWN(") &&
+      base::EndsWith(normalized, ")")) {
+    normalized = normalized.substr(8, normalized.size() - 9);
+  }
+  if (base::StartsWith(normalized, "0X")) {
+    normalized = normalized.substr(2);
+  } else {
+    auto it = SignatureAlgorithms().find(normalized);
+    return it == SignatureAlgorithms().end() ? 0 : it->second;
+  }
+  unsigned value = 0;
+  return base::HexStringToUInt(normalized, &value) && value <= 0xffff
+             ? static_cast<uint16_t>(value)
+             : 0;
+}
+
+std::vector<uint16_t> TLSSignatureAlgorithmMapper::NamesToIds(
+    const std::vector<std::string>& names) {
+  std::vector<uint16_t> result;
+  result.reserve(names.size());
+  for (const auto& name : names) {
+    if (uint16_t id = NameToId(name)) {
+      result.push_back(id);
+    }
+  }
+  return result;
+}
+
+}  // namespace cronet
