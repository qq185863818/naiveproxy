+bool ssl_create_cipher_list_with_order(
+    UniquePtr<SSLCipherPreferenceList> *out_cipher_list,
+    Span<const uint16_t> ids) {
+  if (ids.empty() || out_cipher_list == nullptr) {
+    return false;
+  }
+  UniquePtr<STACK_OF(SSL_CIPHER)> cipherstack(sk_SSL_CIPHER_new_null());
+  Array<bool> in_group_flags;
+  if (cipherstack == nullptr || !in_group_flags.InitForOverwrite(ids.size())) {
+    return false;
+  }
+  for (uint16_t id : ids) {
+    const SSL_CIPHER* cipher = SSL_get_cipher_by_value(id);
+    if (cipher == nullptr || cipher->algorithm_mkey == SSL_kGENERIC) {
+      continue;
+    }
+    if (sk_SSL_CIPHER_find(cipherstack.get(), nullptr, cipher) ||
+        !sk_SSL_CIPHER_push(cipherstack.get(), cipher)) {
+      return false;
+    }
+  }
+  const size_t count = sk_SSL_CIPHER_num(cipherstack.get());
+  if (count == 0) {
+    return false;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    in_group_flags[i] = false;
+  }
+  in_group_flags.Shrink(count);
+  auto list = MakeUnique<SSLCipherPreferenceList>();
+  if (!list || !list->Init(std::move(cipherstack), in_group_flags)) {
+    return false;
+  }
+  *out_cipher_list = std::move(list);
+  return true;
+}
