+namespace cronet {
+
+CronetSSLConfigService::CronetSSLConfigService(
+    std::vector<uint16_t> custom_cipher_suite_ids,
+    std::vector<net::SSLNamedGroupInfo> custom_named_groups,
+    std::vector<uint16_t> custom_signature_algorithm_ids,
+    bool permute_extensions,
+    std::optional<bool> alps_use_new_codepoint,
+    bool send_empty_trust_anchors,
+    std::vector<uint64_t> custom_extension_order,
+    bool randomize_custom_extension_order,
+    std::optional<std::vector<uint8_t>> custom_trust_anchor_ids) {
+  if (!custom_cipher_suite_ids.empty()) {
+    config_.custom_cipher_suite_order = std::move(custom_cipher_suite_ids);
+    config_.use_custom_cipher_order = true;
+  }
+  if (!custom_named_groups.empty()) {
+    config_.supported_named_groups = std::move(custom_named_groups);
+  }
+  if (!custom_signature_algorithm_ids.empty()) {
+    config_.custom_signature_algorithm_prefs =
+        std::move(custom_signature_algorithm_ids);
+  }
+  config_.permute_extensions = permute_extensions;
+  config_.alps_use_new_codepoint = alps_use_new_codepoint;
+  config_.send_empty_trust_anchors = send_empty_trust_anchors;
+  config_.custom_extension_order = std::move(custom_extension_order);
+  config_.randomize_custom_extension_order = randomize_custom_extension_order;
+  config_.custom_trust_anchor_ids = std::move(custom_trust_anchor_ids);
+}
+
+CronetSSLConfigService::~CronetSSLConfigService() = default;
+
+net::SSLContextConfig CronetSSLConfigService::GetSSLContextConfig() {
+  return config_;
+}
+
+bool CronetSSLConfigService::CanShareConnectionWithClientCerts(
+    std::string_view hostname) const {
+  return false;
+}
+
+}  // namespace cronet
