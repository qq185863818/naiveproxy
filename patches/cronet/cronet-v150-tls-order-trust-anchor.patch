+int SSL_set_custom_extension_order(SSL *ssl, const uint64_t *extension_ids,
+                                   size_t extension_ids_len, int randomize) {
+  if (ssl == nullptr || ssl->config == nullptr ||
+      (extension_ids_len != 0 && extension_ids == nullptr)) {
+    return 0;
+  }
+
+  std::vector<uint8_t> filtered;
+  filtered.reserve(extension_ids_len);
+  for (size_t i = 0; i < extension_ids_len; i++) {
+    if (extension_ids[i] > 0xffff) {
+      continue;
+    }
+    uint32_t index = 0;
+    if (tls_extension_find(&index,
+                           static_cast<uint16_t>(extension_ids[i])) ==
+        nullptr) {
+      continue;
+    }
+    const uint8_t index8 = static_cast<uint8_t>(index);
+    if (std::find(filtered.begin(), filtered.end(), index8) == filtered.end()) {
+      filtered.push_back(index8);
+    }
+  }
+
+  ssl->config->custom_extension_order.Reset();
+  ssl->config->randomize_custom_extension_order = !!randomize;
+  if (filtered.empty()) {
+    return 1;
+  }
+  if (!ssl->config->custom_extension_order.InitForOverwrite(filtered.size())) {
+    ssl->config->randomize_custom_extension_order = false;
+    return 0;
+  }
+  std::copy(filtered.begin(), filtered.end(),
+            ssl->config->custom_extension_order.data());
+  return 1;
+}
